# Port on 127.0.0.1 for this site. Check it is free first, from site/: bash deploy/check-server.sh 8150
# Not 8000, 8080, 8100, 8110, 8120, 8130 or 8140 (other projects and Bhava QA).
PORT=8150
# Empty for the normal build. Set to --release once every detail in site.config.json is confirmed.
BUILD_FLAGS=
